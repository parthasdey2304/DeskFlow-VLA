# ── DeskFlow-VLA web environment ─────────────────────────────
# Copy to .env.local (never commit .env.local). Every key below maps to a
# concrete consumer; blanks degrade gracefully (local snapshots / stubs).

# App base URL (used for Razorpay callbacks + Clerk redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Clerk auth (web/app/layout.tsx, web/middleware_auth.ts) ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ── Firebase / Firestore (web/lib/firebase.ts) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-side writes (telemetry/license persist) need a service account.
# Keep this file OUT of the repo; point at it via absolute path:
# FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/deskflow-firebase.json

# ── Razorpay (web/lib/razorpay.ts, web/app/api/razorpay/*) ──
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=change-me
# Signs the license tokens minted in /api/razorpay/verify — MUST differ
# from RAZORPAY_KEY_SECRET in production so payment and license keys
# can be rotated independently:
LICENSE_SIGNING_SECRET=change-me-too

# ── Edge AI fallback tiers (backend-edge/ai_fallback_client.py) ──
MUSE_SPARK_KEY=
GEMINI_API_KEY=
KIRO_API_KEY=
# When =1, tiers with missing keys are skipped instead of attempted:
DESKFLOW_STRICT_KEYS=1
